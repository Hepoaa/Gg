{
  "name": "familyos-cloudflare",
  "private": true,
  "version": "1.1.0-oneclick",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed:demo": "wrangler d1 execute DB --local --file=./scripts/demo-seed.sql",
    "deploy:no-migrations": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.61.0",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "1.48.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260927.1",
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2",
    "wrangler": "4.142.0"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "Base de datos privada D1 de FamilyOS. Cloudflare la crea y enlaza automáticamente."
      },
      "FAMILYOS_FILES": {
        "description": "Bucket privado R2 para documentos y recibos. Cloudflare lo crea y enlaza automáticamente."
      },
      "NVIDIA_API_KEY": {
        "description": "Tu API key de NVIDIA. Se guarda como secreto de Cloudflare y nunca se incluye en el frontend."
      },
      "SESSION_SECRET": {
        "description": "Secreto aleatorio largo para reforzar las sesiones. Usa al menos 32 caracteres aleatorios."
      }
    }
  }
}
